class Cairn < Formula
  desc "Local codebase intelligence: code graph, search, and MCP server"
  homepage "https://github.com/tanlnm512/cairn"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/tanlnm512/cairn/releases/download/v@VERSION@/cairn-cli-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    else
      url "https://github.com/tanlnm512/cairn/releases/download/v@VERSION@/cairn-cli-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/tanlnm512/cairn/releases/download/v@VERSION@/cairn-cli-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    else
      url "https://github.com/tanlnm512/cairn/releases/download/v@VERSION@/cairn-cli-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "cairn"
  end

  def caveats
    <<~EOS
      Binary-only formula. The Python-side extras (document ingest, local
      embeddings) are not included; install the cairn-intel PyPI package
      for those.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cairn --version")
  end
end
